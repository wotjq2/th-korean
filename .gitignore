# Claude Code 로컬 설정 (이 PC 전용)
.claude/

# 번역 도우미(line-helper): 빌드 결과(번역도우미.exe, 예전 LineHelper.exe)와 이 PC 의 설정·용어집 사본
line-helper/*.exe
line-helper/data/
line-helper/node_modules/
# 도우미가 켤 때 크롬에 알리려고 exe 옆에 쓰는 설명 파일(ChromeLink.Register)
line-helper/com.th_korean.helper.json

# 통합 번역 확장: node extension/build.js 가 만드는 폴더(크롬에 불러오는 곳)와 웹스토어에 올릴 zip(--store)
extension/dist/
extension/store/
# 사진 글자 읽기 엔진(8 MB) — build.js 가 jsdelivr 에서 받아 sha256 을 맞춰 보고 여기에 둔다
extension/vendor/worker.min.js
extension/vendor/tha.traineddata.gz
extension/vendor/tesseract-core-*.js
